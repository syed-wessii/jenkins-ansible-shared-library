[Unit]
Description=Redis In-Memory Data Store
After=network.target

[Service]
Type=notify
User={{ redis_user }}
Group={{ redis_group }}

ExecStart=/usr/local/bin/redis-server {{ redis_config_file }}
ExecStop=/usr/local/bin/redis-cli shutdown

Restart=always
RestartSec=3

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
